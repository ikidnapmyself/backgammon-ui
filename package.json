{
    "name": "backgammon-ui",
    "version": "0.1.0",
    "description": "React backgammon board and UI primitives",
    "keywords": [
        "backgammon",
        "react",
        "board",
        "ui",
        "svg",
        "tailwind",
        "radix-ui"
    ],
    "homepage": "https://github.com/ikidnapmyself/backgammon-ui#readme",
    "bugs": {
        "url": "https://github.com/ikidnapmyself/backgammon-ui/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ikidnapmyself/backgammon-ui.git"
    },
    "license": "MIT",
    "author": "Burak",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./styles/board.css": "./styles/board.css",
        "./styles/theme.css": "./styles/theme.css"
    },
    "files": [
        "dist",
        "styles"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "npm run clean && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepublishOnly": "npm run typecheck && npm test && npm run build"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^0.475.0",
        "motion": "^14.0.0",
        "tailwind-merge": "^3.0.1"
    },
    "devDependencies": {
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "typescript": "^5.7.2",
        "vitest": "^3.0.0"
    }
}
